DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/files
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Internal endpoint: how the API reaches MinIO/S3 (inside Docker: http://minio:9000)
S3_ENDPOINT_URL=http://localhost:9000
# Public endpoint: host baked into presigned URLs, must be reachable by the CLIENT
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=uploads

MAX_UPLOAD_SIZE_MB=10
PRESIGNED_EXPIRATION_SECONDS=300
